{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "SmartX": {
    "UploadsRootPath": "wwwroot/uploads",
    "MockSeeder": {
      "Enabled": true,
      "IntervalMilliseconds": 2000,
      "DeviceCount": 8,
      "SpikeProbability": 0.03
    },
    "AnomalyThresholds": {
      "EnvironmentalDelta": 8.0,
      "PowerDeltaWatts": 150.0
    },
    "AlertRules": {
      "PowerCriticalWatts": 800,
      "MoistureCriticalLow": 20,
      "MoistureCriticalHigh": 80,
      "ClearAfterNormalReadings": 3
    },
    "Pipeline": {
      "ProcessingDelayMilliseconds": 20,
      "MaxStandardQueueDepth": 5000
    },
    "Health": {
      "DisconnectTimeoutSeconds": 15
    },
    "Cors": {
      "Origins": []
    }
  }
}
