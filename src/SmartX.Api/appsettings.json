{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SmartX": {
    "UploadsRootPath": "wwwroot/uploads",
    "MockSeeder": {
      "Enabled": true,
      "IntervalMilliseconds": 2000,
      "DeviceCount": 6
    },
    "AnomalyThresholds": {
      "EnvironmentalDelta": 8.0,
      "PowerDeltaWatts": 150.0
    }
  }
}
