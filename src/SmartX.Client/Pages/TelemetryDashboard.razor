@page "/dashboard"
@inherits StateAwareComponent
@inject SmartXApiClient Api

<PageTitle>Telemetry Dashboard — Smart-X</PageTitle>

<h1>Telemetry Dashboard</h1>
<p class="subtitle">Live feed of every processed reading, pushed over SignalR the instant the gateway handles it.</p>

<div class="dashboard-grid">

    <!-- ============ Engagement feature: Anomaly Heartbeat ============ -->
    <div class="heartbeat-card @(State.LastWasAnomaly ? "heartbeat-alert" : "heartbeat-calm")">
        <h2>Anomaly Heartbeat</h2>
        <p class="heartbeat-caption">
            @if (State.LastWasAnomaly)
            {
                <span>⚠️ Spike detected on <strong>@State.LastSensorId</strong></span>
            }
            else
            {
                <span>All sensors nominal</span>
            }
        </p>

        <svg viewBox="0 0 300 80" class="heartbeat-svg" preserveAspectRatio="none">
            <polyline class="heartbeat-line" points="0,40 40,40 55,10 70,70 85,40 130,40 145,15 160,65 175,40 300,40" />
        </svg>

        <div class="streak-row">
            <div class="streak-count">
                <span class="streak-number">@State.AnomalyFreeStreak</span>
                <span class="streak-label">readings anomaly-free</span>
            </div>
            <div class="badge-row">
                @foreach (var badge in State.EarnedBadges)
                {
                    <span class="badge-pill">@badge</span>
                }
            </div>
        </div>

        @if (State.ToastMessage is not null)
        {
            <div class="toast">🏅 @State.ToastMessage</div>
        }
    </div>

    <!-- ============ Manual ingestion + operator-overload demos ============ -->
    <div class="form-card">
        <h2>Manual Test Reading</h2>
        <label>Sensor ID</label>
        <input @bind="State.ManualReading.SensorId" placeholder="ESP32-01" />

        <label>Kind</label>
        <select @bind="State.ManualReading.Kind">
            <option value="@TelemetryValueKind.Float">Float (environmental)</option>
            <option value="@TelemetryValueKind.Integer">Integer (power, Watts)</option>
            <option value="@TelemetryValueKind.Boolean">Boolean (actuator)</option>
        </select>

        @if (State.ManualReading.Kind == TelemetryValueKind.Boolean)
        {
            <label><input type="checkbox" @bind="State.ManualReading.Bool" /> Value (ON/OFF)</label>
        }
        else
        {
            <label>Value</label>
            <input type="number" @bind="State.ManualReading.Numeric" />
        }

        <button class="cta-button" @onclick="SendManualReadingAsync">Send Reading</button>

        @if (!string.IsNullOrEmpty(_manualMessage))
        {
            <p class="form-message">@_manualMessage</p>
        }

        <hr />

        <h3>Aggregate Two Meters (operator overload demo)</h3>
        <input @bind="State.ManualReading.AggregateA" placeholder="Sensor A id" />
        <input @bind="State.ManualReading.AggregateB" placeholder="Sensor B id" />
        <button class="cta-button" @onclick="RunAggregateAsync">Meter3 = A + B</button>
        @if (!string.IsNullOrEmpty(_aggregateMessage))
        {
            <p class="form-message">@_aggregateMessage</p>
        }

        <hr />

        <h3>Seed Jagged Batch (array demo)</h3>
        <button class="cta-button" @onclick="SeedBatchAsync">Seed 4 Devices</button>
        @if (_lastBatchResult is not null)
        {
            <p class="form-message">
                Row lengths: [@string.Join(", ", _lastBatchResult.RowLengths)] — flattened to @_lastBatchResult.PacketCount packets.
            </p>
        }
    </div>

    <!-- ============ Live feed ============ -->
    <div class="form-card feed-card">
        <h2>Live Feed</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Time (UTC)</th>
                    <th>Sensor</th>
                    <th>Value</th>
                    <th>Lane</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in State.Feed.Take(FeedDisplayLimit))
                {
                    <tr class="@(item.IsAnomaly ? "row-anomaly" : "")">
                        <td>@item.TimestampUtc.ToString("HH:mm:ss")</td>
                        <td>@item.SensorId</td>
                        <td>@item.DisplayValue</td>
                        <td>
                            <span class="lane-chip @(item.Lane == AlertPriority.Critical ? "lane-priority" : "lane-standard")">
                                @(item.Lane == AlertPriority.Critical ? "PRIORITY" : "standard")
                            </span>
                        </td>
                        <td>@(item.IsAnomaly ? "⚠️" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private const int FeedDisplayLimit = 30;

    private string _manualMessage = string.Empty;
    private string _aggregateMessage = string.Empty;
    private BatchSeedResult? _lastBatchResult;

    protected override async Task OnInitializedAsync()
    {
        // The shared state owns the SignalR subscription and the feed, so this page only has to make sure it started.
        await State.EnsureStartedAsync();
    }

    private async Task SendManualReadingAsync()
    {
        var draft = State.ManualReading;

        var request = new TelemetryIngestRequest
        {
            SensorId = draft.SensorId,
            Kind = draft.Kind,
            NumericValue = draft.Numeric,
            BooleanValue = draft.Bool,
            Unit = draft.Kind switch
            {
                TelemetryValueKind.Float => "% moisture",
                TelemetryValueKind.Integer => "W",
                _ => ""
            }
        };

        try
        {
            var ack = await Api.IngestTelemetryAsync(request);
            _manualMessage = ack is null
                ? string.Empty
                : $"Accepted into the {(ack.Lane == AlertPriority.Critical ? "PRIORITY" : "standard")} lane (packet #{ack.Sequence}).";
        }
        catch (Exception ex)
        {
            _manualMessage = $"Error: {ex.Message}";
        }
        // The processed reading arrives back over SignalR and appears in the feed.
    }

    private async Task RunAggregateAsync()
    {
        try
        {
            var result = await Api.GetAggregateAsync(State.ManualReading.AggregateA, State.ManualReading.AggregateB);
            _aggregateMessage = result is null
                ? "No result returned."
                : $"{result.SensorId} = {result.Value:F2}{result.Unit}";
        }
        catch (Exception ex)
        {
            _aggregateMessage = $"Error: {ex.Message}";
        }
    }

    private async Task SeedBatchAsync()
    {
        try
        {
            _lastBatchResult = await Api.SeedBatchAsync(devices: 4, samplesPerDevice: 5);
        }
        catch (Exception ex)
        {
            _aggregateMessage = $"Error: {ex.Message}";
        }
    }
}
